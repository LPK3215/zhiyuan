# ============================================================
# 生产环境配置模板
#
# 使用方法：
#   1. 复制本文件为 .env.prod
#   2. 填入实际的生产环境凭证
#   3. docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# 安全提醒：
#   - .env.prod 包含敏感凭证，已在 .gitignore 中排除
#   - 生产环境推荐使用密钥管理服务（如 Vault）而非明文文件
#   - 若密钥泄露，请立即在各平台轮换
# ============================================================

# ---- 模型供应商 API Key（至少配置一个） ----
SILICONFLOW_API_KEY=
TAVILY_API_KEY=
DEEPSEEK_API_KEY=

# ---- 应用核心配置（必填） ----
YUXI_ENV=production
# JWT 密钥：使用 `openssl rand -hex 32` 生成
JWT_SECRET_KEY=
# 实例 ID：使用 `openssl rand -hex 16` 生成
YUXI_INSTANCE_ID=

# CORS 允许的前端源（逗号分隔），生产环境必须显式设置
# 例如：YUXI_CORS_ORIGINS=https://zhiyuan.example.com
YUXI_CORS_ORIGINS=

# 受信代理 IP/CIDR（逗号分隔），仅当经过反向代理时才需要设置
# 例如：YUXI_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
YUXI_TRUSTED_PROXIES=

# ---- 数据库（必填） ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=yuxi
# 如需自定义连接串（覆盖以上三参数拼接的默认值）：
# POSTGRES_URL=postgresql+asyncpg://postgres:PASSWORD@postgres:5432/yuxi

# ---- Redis ----
# 默认 redis://redis:6379/0，如需自定义：
# REDIS_URL=redis://redis:6379/0

# ---- MinIO / 对象存储（必填） ----
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ---- Neo4j 图数据库（必填） ----
NEO4J_URI=bolt://graph:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---- Milvus 向量数据库 ----
MILVUS_URI=http://milvus:19530
MILVUS_DB_NAME=default
MILVUS_TOKEN=

# ---- OCR 服务（可选） ----
MINERU_API_URI=http://mineru-api:30001
PADDLEX_URI=http://paddlex:8080

# ---- 沙盒（必填） ----
SANDBOX_PROVIDER=provisioner
SANDBOX_PROVISIONER_URL=http://sandbox-provisioner:8002
# 至少 32 个字符；使用 `openssl rand -hex 32` 生成
SANDBOX_PROVISIONER_TOKEN=
SANDBOX_VIRTUAL_PATH_PREFIX=/home/gem/user-data
SANDBOX_EXEC_TIMEOUT_SECONDS=180
SANDBOX_MAX_OUTPUT_BYTES=262144

# ---- 沙盒 Provisioner 后端配置 ----
SANDBOX_PROVISIONER_BACKEND=docker
SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
SANDBOX_CONTAINER_PORT=8080
SANDBOX_HEALTH_TIMEOUT_SECONDS=300
SANDBOX_IDLE_TIMEOUT_SECONDS=120
SANDBOX_IDLE_CHECK_INTERVAL_SECONDS=10

# ---- 版本号 ----
YUXI_VERSION=0.7.1

# ---- 时区 ----
TZ=Asia/Shanghai
